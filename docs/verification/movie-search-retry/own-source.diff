+/** One transport active, one replaceable latest pending read per workspace. */
+export function createLibrarySearchRequests(send) {
+  let active = null;
+  let pending = null;
+  let disposed = false;
+  const superseded = { status: 'superseded' };
+
+  function start(entry) {
+    active = entry;
+    // Start synchronously: the first keystroke is not debounced.
+    let transport;
+    try { transport = send(entry.descriptor); }
+    catch (error) { transport = Promise.reject(error); }
+    Promise.resolve(transport).then(
+      data => entry.resolve(disposed ? superseded : { status: 'complete', data, descriptor: entry.descriptor }),
+      error => disposed ? entry.resolve(superseded) : entry.reject(error)
+    ).finally(() => {
+      active = null;
+      const next = pending;
+      pending = null;
+      if (next && !disposed) start(next);
+    });
+  }
+
+  return {
+    request(descriptor) {
+      if (disposed) return Promise.resolve(superseded);
+      return new Promise((resolve, reject) => {
+        const entry = { descriptor: structuredClone(descriptor), resolve, reject };
+        if (!active) start(entry);
+        else {
+          pending?.resolve(superseded);
+          pending = entry;
+        }
+      });
+    },
+    dispose() {
+      disposed = true;
+      pending?.resolve(superseded);
+      pending = null;
+      active?.resolve(superseded);
+    }
+  };
+}
